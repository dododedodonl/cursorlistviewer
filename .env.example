APP_NAME="Cursor ListViewer"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://listcursor.nl

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# No database is required; sessions and cache use the file driver.
DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=172800
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

FEED_URL=https://www.cursor.tue.nl/rss.xml
FEED_CACHE_TTL=600

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
